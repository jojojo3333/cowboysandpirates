# Pinned engine binary, fetched by tools/setup_godot.sh
.godot-bin/

# Godot's import cache and editor state
.godot/
*.import

# export_presets.cfg is deliberately NOT ignored. It is usually treated as
# local editor state, but CI cannot export without it, and the web build is
# produced by CI. It carries no secrets.

# Build output
build/
*.zip

# OS noise
.DS_Store
Thumbs.db
